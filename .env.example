# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=password
POSTGRES_DB=devpulse
POSTGRES_PORT=5432

# development | production (production turns on Secure cookies)
ENVIRONMENT=development

# The origin the browser uses. The API is reached through it at /api.
FRONTEND_BASE_URL=http://localhost:5173

# From your GitHub App settings. Leave empty until the App is registered;
# "Continue with GitHub" then shows a "not available" message.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Needed to connect GitHub and read repositories (slice 2 onward). None of these is
# a secret except the private key FILE, which must never be committed.
GITHUB_APP_ID=
# The app's URL name: github.com/apps/<slug>
GITHUB_APP_SLUG=
# Path to the downloaded .pem, as seen from the backend folder when you run it on
# your machine. Docker Compose mounts ./secrets and overrides this for containers.
GITHUB_APP_PRIVATE_KEY_PATH=../secrets/github-app.pem

# Used when running the API or worker on your machine (Docker overrides it).
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Background sync tuning. The defaults suit normal use; smaller values are for trying it out.
# How often the scheduler queues a job for every connection (seconds).
SYNC_INTERVAL_SECONDS=900
# A job run stops cleanly after this long and carries on in the next run (seconds).
SYNC_RUN_BUDGET_SECONDS=480
# Stop a run when GitHub says fewer than this many requests are left this hour.
SYNC_RATE_LIMIT_RESERVE=200
# Cap on GitHub requests per run; 0 means no cap. Try 3 to see a long history import
# finish over several runs.
SYNC_RUN_MAX_REQUESTS=0
